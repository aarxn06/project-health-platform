# Backend Configuration
FLASK_ENV=development
PORT=5000
SECRET_KEY=change-this-in-production-academic-demo-key

# Database Configuration (SQLite default; can be switched to mysql+pymysql://user:pass@host:3306/dbname)
DATABASE_URL=sqlite:///project_health.db

# Upload & Security Limits
MAX_UPLOAD_SIZE_MB=25
MAX_EXTRACTED_FILES=2000
MAX_EXTRACTED_SIZE_MB=100

# Machine Learning Model Integration
ML_MODEL_PATH=ml/models/defect_predictor.joblib
ML_METADATA_PATH=ml/models/model_metadata.json

# Frontend Configuration (for Vite)
VITE_API_BASE_URL=http://localhost:5000/api
